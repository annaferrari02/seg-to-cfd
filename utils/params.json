{
  "segments": {
    "1": "cisx", "2": "cidx", "3": "iedx", "4": "iesx", "5": "ardx", "6": "arsx",
    "7": "sma", "8": "ca", "9": "lumen", "10": "iidx", "11": "iisx"
  },

  "step0": {    "hu_check": {
      "segment": "lumen",
      "mean_hu_range": [
        100,
        800
      ]
    },
    "filters": [
      {"op": "remove_above", "segments": "all", "hu_max": 400,
       "adaptive": {"ref": "lumen", "k": 3}, "max_frac": 0.2},
      {"op": "smoothing", "segments": "lumen", "method": "MORPHOLOGICAL_CLOSING", "size_mm": 5.0},
      {"op": "smoothing", "segments":"lumen", "method": "GAUSSIAN", "size_mm": 1.00},
      {"op": "margin", "segments": ["ardx", "arsx", "sma", "iisx", "iidx", "lumen"], "size_mm": 1.0},
      {"op": "smoothing", "segments": "all", "method": "MEDIAN", "size_mm": 1.0},
      {"op": "smoothing", "segments": "all", "method": "MORPHOLOGICAL_CLOSING", "size_mm": 2.0},
      {"op": "smoothing", "segments": "all", "method": "MORPHOLOGICAL_OPENING", "size_mm": 2.0},
      {"op": "merge", "segments": "all", "name": "tree"},
      {"op": "smoothing", "segments": ["tree"], "method": "MEDIAN", "size_mm": 2.0}
    ]
  },

    "step1": {
    "source_segment": "tree",
    "surface_smoothing": 0.5,
    "inlet_segment": "lumen",
